<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- CareBridge has one light appearance, so the same launch and window
         themes apply in the system's dark mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Removed automatically when Flutter draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window color behind the Flutter UI once it is running. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
